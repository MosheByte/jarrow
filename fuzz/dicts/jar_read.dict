# libFuzzer dictionary for jar_read: zip record signatures, the entry names a mod jar
# uses, and the class-file magic number.
local_header="PK\x03\x04"
central_header="PK\x01\x02"
end_of_central_directory="PK\x05\x06"
zip64_end_of_central_directory="PK\x06\x06"
zip64_locator="PK\x06\x07"
data_descriptor="PK\x07\x08"
zip64_extra="\x01\x00\x08\x00"
deflate="\x08\x00"
utf8_flag="\x00\x08"
"META-INF/MANIFEST.MF"
"META-INF/jars/"
"META-INF/jarjar/"
"META-INF/neoforge.mods.toml"
"fabric.mod.json"
".class"
".jar"
"Manifest-Version: 1.0\x0D\x0A"
class_magic="\xCA\xFE\xBA\xBE"
