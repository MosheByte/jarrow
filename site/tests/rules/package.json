{
  "name": "jarrow-site-quality",
  "version": "0.0.0",
  "private": true,
  "description": "Checks of the built site against the thirty rules (docs/design/thirty-rules.md), the screenshot capture and the Lighthouse summary used by .github/workflows/site-quality.yml.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"*.test.mjs\"",
    "unit": "node --test \"lib/*.test.mjs\"",
    "serve": "node serve.mjs",
    "screenshots": "node screenshots.mjs",
    "lighthouse-summary": "node lighthouse-summary.mjs"
  },
  "devDependencies": {
    "@lhci/cli": "0.16.0",
    "playwright": "1.64.1",
    "postcss": "8.5.32"
  }
}
