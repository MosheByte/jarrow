---
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
}
const { title, eyebrow, lead } = Astro.props;
---

<header class="jw-intro">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {lead && <p class="jw-intro-lead">{lead}</p>}
</header>

<style>
  .jw-intro {
    max-width: 52rem;
    margin-bottom: 2rem;
  }

  h1 {
    margin-top: 0.75rem;
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 800;
  }

  .jw-intro-lead {
    margin-top: 1rem;
    font-size: 1.2rem;
    color: var(--jw-muted);
  }
</style>
