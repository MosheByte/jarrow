---
// The GitHub mark from Simple Icons (CC0-1.0 package; GitHub's own logo guidelines apply:
// https://github.com/logos). Used only to label links to the GitHub repository.
import { siGithub } from 'simple-icons';

interface Props {
  size?: number;
  class?: string;
}
const { size = 20, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
><path d={siGithub.path} /></svg>
