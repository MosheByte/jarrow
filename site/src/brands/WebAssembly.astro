---
// The WebAssembly icon, white variant: dist/icon/web-assembly-icon-white.svg from
// carlosbaraza/web-assembly-logo at commit f0f411529c1dafffa233be1bd95b80b79144b675 (file
// SHA-256 285a1e4032d3964c013f073293efce2e6bac9994885cac530da0e6619cc6e988), downloaded
// 2026-11-03. The WebAssembly Community Group chose it as the official logo in
// https://github.com/WebAssembly/design/issues/980, released under CC0 1.0.
//
// viewBox, polygon points, path data and the white fill are unmodified. Markup only: the
// class-based fill (a style block, which would leak into the page if inlined) is a fill
// attribute on the root, and the title, ids and empty groups are gone so the icon can appear
// twice on one page. The official colourways are purple, white and black; on the dark page it
// is white. Terms: site/BRAND-SOURCES.md. Render it through BrandMark.astro.
interface Props {
  size?: number;
  class?: string;
}
const { size = 16, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 107.62 107.62"
  fill="#fff"
  aria-hidden="true"
  focusable="false"
  data-brand="webassembly"
  data-brand-source="https://github.com/carlosbaraza/web-assembly-logo"
><polygon points="79.87 67.39 76.76 81.38 86.44 81.38 82.87 67.39 79.87 67.39"></polygon><path d="M66.13,0a5.62,5.62,0,0,1,0,.58A12.34,12.34,0,0,1,53.81,12.92,12.33,12.33,0,0,1,41.47.58a5.62,5.62,0,0,1,0-.58H0V107.62H107.62V0ZM51.38,96.1,46.13,70.17H46L40.39,96.1H33.17L25,58h7.13L37,83.94h.09L42.94,58h6.67l5.28,26.26H55L60.55,58h7L58.46,96.1Zm39.26,0-2.43-8.48H75.4L73.53,96.1H66.36L75.58,58H86.83L98,96.1Z"></path></svg>
