---
// Server-rendered so the board counter always reflects board.json in KV.
export const prerender = false;

import ArrowRight from '@lucide/astro/icons/arrow-right';
import BookOpen from '@lucide/astro/icons/book-open';
import MapIcon from '@lucide/astro/icons/map';

import BoardCounter from '../components/BoardCounter.astro';
import GitHubMark from '../components/GitHubMark.astro';
import NotBuilt from '../components/NotBuilt.astro';
import Base from '../layouts/Base.astro';
import { greenPercent, hasRun } from '../lib/board.ts';
import { readBoard } from '../lib/runtime.ts';
import { CI_BADGE_URL, CI_WORKFLOW_URL, MISSION, PRODUCT_NAME, REPO_URL, ROADMAP_PROJECT_URL } from '../lib/site.ts';

const load = await readBoard();
const parity = hasRun(load) ? greenPercent(load.board.totals) : null;

const unreadable = load.status === 'invalid' || load.status === 'error';
// A board we could not read must not be cached as if it were the real one.
Astro.response.headers.set('Cache-Control', unreadable ? 'no-store' : 'public, max-age=300');

// The fixed build order (ROADMAP.md, "Directions"; D-029). A direction is offered only once it has a
// board column and a converter. Only Fabric -> NeoForge has a column, and no converter exists, so every
// status here is "not started" or "in progress".
const buildOrder = [
  {
    step: 1,
    directions: ['Fabric → NeoForge'],
    status: 'In progress: milestone M0 now, then M1, the harness and the board.',
  },
  { step: 2, directions: ['NeoForge → Fabric'], status: 'Not started.' },
  { step: 3, directions: ['Fabric → Quilt', 'Quilt → Fabric'], status: 'Not started.' },
  { step: 4, directions: ['Forge → NeoForge', 'NeoForge → Forge'], status: 'Not started.' },
  { step: 5, directions: ['Fabric → Forge', 'Forge → Fabric'], status: 'Not started.' },
  {
    step: 6,
    directions: ['Quilt → Forge', 'Forge → Quilt', 'Quilt → NeoForge', 'NeoForge → Quilt'],
    status: 'Not started.',
  },
];
---

<Base
  title={PRODUCT_NAME}
  description="Jarrow's goal for v1: convert a Minecraft mod between Fabric, NeoForge, Forge and Quilt, in every direction, and prove each result with a behaviour harness. Nothing converts yet: the project is in milestone M0."
>
  <div class="wrap">
    <section class="hero" aria-labelledby="mission">
      <p class="eyebrow">Any loader to any loader · planned for v1 · open source</p>
      <h1 id="mission">{MISSION}</h1>
      <p class="lead">
        The goal for v1 is any loader to any loader: Fabric, NeoForge, Forge and Quilt, every pair in both
        directions, on Minecraft 1.20.1, 1.21.1 and 1.21.11. {PRODUCT_NAME} will convert the JAR itself, not
        shim it at runtime, and it will only call a conversion good when a behaviour harness says so.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="/docs/">
          <BookOpen size={20} aria-hidden="true" />
          Read the docs
        </a>
        <a class="btn btn-ghost" href={ROADMAP_PROJECT_URL}>
          <MapIcon size={20} aria-hidden="true" />
          Roadmap project
        </a>
        <a class="btn btn-ghost" href={REPO_URL}>
          <GitHubMark size={20} />
          GitHub
        </a>
      </div>
    </section>

    <NotBuilt milestone="M3" what="The converter">
      <p>
        Nothing converts yet. This page gets a drop zone when the converter works in the browser, and not
        before: a drop zone that did nothing would be a lie. Follow the build on the
        <a href="/roadmap/">roadmap</a>.
      </p>
    </NotBuilt>

    <div class="grid">
      <section class="how card" aria-labelledby="how-title">
        <h2 id="how-title">How it will work</h2>
        <ol>
          <li>
            <span class="step" aria-hidden="true">1</span>
            <p>
              Drop a mod JAR and pick the loader you want it for. The page reads its manifest and sorts it into
              a tier:
              <span class="tier tier-a">Tier A</span>, <span class="tier tier-b">Tier B</span> or
              <span class="tier tier-unsupported">Unsupported</span>.
            </p>
          </li>
          <li>
            <span class="step" aria-hidden="true">2</span>
            <p>
              Tier A converts in your browser, so the JAR never leaves your machine. Tier B runs as a short-lived
              GitHub Actions job for signed-in users.
            </p>
          </li>
          <li>
            <span class="step" aria-hidden="true">3</span>
            <p>
              A parity harness starts the original on its own loader and the result on the target loader, and
              compares what each server registers. That comparison, not a compiler, decides green, yellow or red.
            </p>
          </li>
        </ol>
      </section>

      <BoardCounter load={load}>
        <p><a href="/board/" class="board-link">Open the board <ArrowRight size={18} aria-hidden="true" /></a></p>
      </BoardCounter>
    </div>

    <section class="directions card" aria-labelledby="directions-title">
      <h2 id="directions-title">Directions</h2>
      <p class="directions-lead">
        Twelve directions, built in a fixed order. None is available yet: a direction is offered here only once it
        has its own column on the nightly board and a converter. Only Fabric → NeoForge has a column so far, and
        every mod in it is red because no converter exists yet.
      </p>
      <ol class="order">
        {
          buildOrder.map(({ step, directions, status }) => (
            <li>
              <span class="step" aria-hidden="true">
                {step}
              </span>
              <div>
                <p class="order-names">
                  <span class="sr-only">Step {step}: </span>
                  {directions.map((name, i) => (
                    <span class="order-dir">{i < directions.length - 1 ? `${name},` : name}</span>
                  ))}
                </p>
                <p class="order-status">{status}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p>
        <a href="/docs/directions/" class="board-link">
          All 12 directions and their bars <ArrowRight size={18} aria-hidden="true" />
        </a>
      </p>
    </section>

    <section class="badges" aria-labelledby="badges-title">
      <h2 id="badges-title" class="eyebrow">Project signals</h2>
      <ul>
        <li class="pill">
          {
            parity === null ? (
              <>
                <span class="result-dot result-not-run" aria-hidden="true" />
                parity: <strong>not measured yet</strong>
              </>
            ) : (
              <>parity: <strong>{parity}% green</strong></>
            )
          }
        </li>
        <li class="pill">
          <span class="result-dot result-not-run" aria-hidden="true" />
          fabric-api coverage: <strong>not measured yet</strong>
        </li>
        <li>
          <a href={CI_WORKFLOW_URL} class="ci-badge">
            <img src={CI_BADGE_URL} alt="CI workflow status on main" height="20" loading="lazy" decoding="async" />
          </a>
        </li>
      </ul>
    </section>
  </div>
</Base>

<style>
  .hero {
    padding-block: 1.5rem 2.5rem;
    max-width: 62rem;
  }

  .hero h1 {
    margin-top: 1rem;
    font-size: clamp(2.1rem, 1.1rem + 4.6vw, 4.6rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .lead {
    margin-top: 1.25rem;
    max-width: 44rem;
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    color: var(--jw-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .grid {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: 1.6fr 1fr;
      align-items: start;
    }
  }

  .how {
    padding: 1.5rem 1.6rem;
  }

  .how h2 {
    font-size: 1.6rem;
    margin-bottom: 1rem;
  }

  .how ol {
    display: grid;
    gap: 1rem;
  }

  .how li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.75rem;
    align-items: start;
  }

  .step {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.75rem;
    background: var(--jw-surface-2);
    border: 1px solid var(--jw-border);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
  }

  .directions {
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
    padding: 1.5rem 1.6rem;
  }

  .directions h2 {
    font-size: 1.6rem;
  }

  .directions-lead {
    max-width: 48rem;
    color: var(--jw-muted);
  }

  .order {
    display: grid;
    gap: 0.9rem;
  }

  @media (min-width: 48rem) {
    .order {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .order li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.75rem;
    align-items: start;
  }

  /* One direction per item, so a name such as "Quilt → Fabric" never breaks across lines. */
  .order-names {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.4em;
    font-weight: 700;
  }

  .order-dir {
    white-space: nowrap;
  }

  .order-status {
    color: var(--jw-muted);
  }

  .board-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 700;
  }

  .badges {
    margin-top: 2rem;
  }

  .badges ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.6rem;
  }

  .ci-badge {
    display: inline-flex;
    min-height: 1.75rem;
    align-items: center;
  }

  .ci-badge img {
    display: block;
    height: 20px;
    width: auto;
  }
</style>
